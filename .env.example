# -----------------------------------------------------------------------------
# Variáveis de Ambiente — Marcio Rogério Imóveis
# -----------------------------------------------------------------------------

# Chave secreta do Payload CMS (qualquer texto longo e aleatório para criptografia de tokens e cookies)
PAYLOAD_SECRET=sua-chave-secreta-aleatoria-payload-2026

# URL de conexão PostgreSQL do Supabase
# Exemplo do Supabase: postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO].supabase.co:5432/postgres
DATABASE_URI=

# Supabase Storage via S3 (credenciais criadas em Storage > S3 Configuration)
# Crie o bucket "site-media" no Supabase e mantenha-o privado.
# Endpoint: https://[PROJECT-REF].storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_BUCKET=site-media
SUPABASE_STORAGE_S3_ENDPOINT=
SUPABASE_STORAGE_S3_REGION=sa-east-1
SUPABASE_STORAGE_S3_ACCESS_KEY_ID=
SUPABASE_STORAGE_S3_SECRET_ACCESS_KEY=

# URL oficial do seu site em produção com o seu domínio
NEXT_PUBLIC_SITE_URL=https://www.marciorjcorretor.com.br

